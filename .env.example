# ==============================================================================
# ASTRA-GUARD Environment Configuration
# ==============================================================================

# General
ENVIRONMENT=development
PROJECT_NAME="ASTRA-GUARD"
VERSION="0.1.0"
LOG_LEVEL=INFO

# API Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database (PostgreSQL + TimescaleDB)
# Async URL for FastAPI async sessions
DATABASE_URL=postgresql+asyncpg://astraguard:astraguard@localhost:5432/astraguard
# Synchronous URL for Alembic migrations
DATABASE_SYNC_URL=postgresql://astraguard:astraguard@localhost:5432/astraguard

# PostgreSQL Container Configuration
POSTGRES_USER=astraguard
POSTGRES_PASSWORD=astraguard
POSTGRES_DB=astraguard
POSTGRES_PORT=5432

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
PORT=3000

# Risk Engine Config
RISK_ENGINE_CONFIG=config/risk_engine.yaml

# Data Providers (Optional credentials)
SPACE_TRACK_USER=
SPACE_TRACK_PASSWORD=
CELESTRAK_BASE_URL=https://celestrak.org

# Notification Core & Security
SECRET_KEY=astraguard-dev-secret-key-change-in-production
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Telegram Bot (Real)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=AstraGuardAlertsBot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MODE=polling

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=mission-safety@astraguard.esa.int

# ntfy Push Alerts
NTFY_BASE_URL=https://ntfy.sh

# SMTP Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@astraguard.esa.int
SMTP_USE_TLS=true

# Twilio SMS / WhatsApp (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

